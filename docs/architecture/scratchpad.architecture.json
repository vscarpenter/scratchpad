  "cards": [
    {
      "dot": "emerald",
      "title": "Local-first by default",
      "items": [
        "Notes live in IndexedDB, with no network requests after page load",
        "The service worker caches the app shell and never intercepts /api/share",
        "A linked folder keeps a two-way Markdown copy on disk"
      ]
    },
    {
      "dot": "rose",
      "title": "Encrypted sharing",
      "items": [
        "The browser generates the AES-GCM key and carries it in the #k= fragment",
        "Only ciphertext and IV reach AWS, and the key never leaves the URL",
        "Shares expire in 7 to 30 days, and senders can revoke them early"
      ]
    },
    {
      "dot": "cyan",
      "title": "Hardened edge",
      "items": [
        "The router maps unknown paths to real pages so headers always apply",
        "A viewer-response function adds CSP and HSTS to every response",
        "The share Lambda answers 404 without the CloudFront origin secret"
      ]
    }
  ]
