{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023", "DOM", "WebWorker"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "playwright.config.js",
    "public/js/dialogs.js",
    "public/js/html-to-markdown.js",
    "public/js/mentions.js",
    "public/js/paste.js",
    "public/js/search.js",
    "public/js/templates.js",
    "public/js/search-view.js",
    "scripts/quality/**/*.mjs"
  ],
  "exclude": ["node_modules", "public/js/vendor"]
}
