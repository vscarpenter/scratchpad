# Scratchpad — gitignore.
# This is a static-only app with no build step. Most ignores below are
# defensive (OS cruft, secrets, future tooling).

# ---- Secrets ----
# Never commit real env files. The .example file IS committed.
.env
.env.local
.env.*.local
!.env.local.example

# ---- OS / editor cruft ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
*~
*.swp
*.swo

# ---- Editor / IDE ----
.idea/
.vscode/
*.iml

# ---- Local agent/tooling artifacts ----
.claude/
.agents/
# .impeccable/design.json IS committed — it's the DESIGN.md sidecar (tonal
# ramps, dark-mode tokens, component snippets) and belongs with the design
# system. Everything else the tool writes here stays local. Note the `/*`:
# git can't re-include a file whose parent directory is itself excluded.
.impeccable/*
!.impeccable/design.json

# ---- Logs ----
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Dev tooling (Playwright) ----
# package.json + bun.lock + playwright.config.js ARE committed (test recipe).
# These directories/files are generated and never deployed.
node_modules/
dist/
build/
.cache/
playwright-report/
test-results/
blob-report/
.playwright-mcp/

# bun is the package manager here — npm/pnpm/yarn lockfiles are not tracked.
package-lock.json
pnpm-lock.yaml
yarn.lock

# ---- Local verification artifacts ----
# Screenshots from local browser-driven verification. Not part of the app.
.verify/

# ---- Session status dashboard (agent-generated, local only) ----
status.html
