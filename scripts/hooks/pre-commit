#!/bin/sh
# Pre-commit hook: block staged additions that write markup into the DOM as
# a raw string, via .innerHTML/.outerHTML assignment or insertAdjacentHTML().
#
# Only ADDED lines (diff lines starting with "+") are checked, so
# pre-existing code never blocks an unrelated commit.
#
# Sanctioned pattern instead (see CLAUDE.md "HTML/JS safety"):
#   DOMPurify.sanitize(raw, { RETURN_DOM_FRAGMENT: true }) + replaceChildren()
#
# Activate with: git config core.hooksPath scripts/hooks

set -eu

pattern='\.(innerHTML|outerHTML)[[:space:]]*(\+=|=[^=])|insertAdjacentHTML[[:space:]]*\('

files=$(git diff --cached --name-only -- '*.js' '*.html')

found=0

for f in $files; do
  case "$f" in
    public/js/vendor/*|node_modules/*|*/node_modules/*)
      continue
      ;;
  esac

  hits=$(git diff --cached --unified=0 -- "$f" | awk -v file="$f" '
    /^@@/ {
      match($0, /\+[0-9]+/)
      lineno = substr($0, RSTART + 1, RLENGTH - 1) + 0
      next
    }
    /^\+\+\+/ { next }
    /^\+/ {
      print file ":" lineno ":" substr($0, 2)
      lineno++
      next
    }
  ' | grep -E "$pattern" || true)

  if [ -n "$hits" ]; then
    if [ "$found" -eq 0 ]; then
      echo "pre-commit: staged changes write raw HTML into the DOM:"
      echo
    fi
    echo "$hits"
    found=1
  fi
done

if [ "$found" -eq 1 ]; then
  echo
  echo "Use DOMPurify.sanitize(raw, { RETURN_DOM_FRAGMENT: true }) + replaceChildren() instead (CLAUDE.md: HTML/JS safety)."
  exit 1
fi

exit 0
